// Cloudflare Containers: un Worker recibe las peticiones HTTPS y las reenvia
// al contenedor con la imagen del backend (requiere el plan Workers Paid).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talentmatch-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "containers": [
    {
      "class_name": "TalentmatchBackend",
      // Dockerfile del backend; se construye desde la raiz del repositorio
      // porque la imagen incluye conf/ y database/migrations.
      "image": "../../backend/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "TalentmatchBackend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TalentmatchBackend"] }],
  // Variables NO secretas. Los secretos (DB_URL, DB_USER, DB_PASSWORD, JWT_SECRET)
  // se cargan con "wrangler secret put" o desde el workflow de despliegue.
  "vars": {
    "CORS_ORIGENES": "https://talentmatch.pages.dev"
  },
  "observability": { "enabled": true }
}
