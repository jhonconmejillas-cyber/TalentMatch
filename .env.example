# TalentMatch - variables de entorno locales (RNF-07)
# Copiar a .env (en la raiz del repo) y completar. El archivo .env NUNCA se sube a Git.
#
# Cadena de conexion de Supabase: Project Settings -> Database -> Connection string -> JDBC.
# Usar el "Session pooler" y agregar sslmode=require. Ejemplo:
#   DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Para una base PostgreSQL local:
#   DB_URL=jdbc:postgresql://localhost:5432/talentmatch

DB_URL=
DB_USER=
DB_PASSWORD=
